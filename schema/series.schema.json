{
  "$ref": "#/definitions/Series",
  "definitions": {
    "Series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seriesId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "seriesTitle": {
            "type": "string",
            "pattern": "\\S"
          },
          "seriesRecordings": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:-\\d+)?$"
            },
            "minItems": 1
          }
        },
        "required": [
          "seriesId",
          "seriesTitle",
          "seriesRecordings"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
