{
  "$ref": "#/definitions/Topics",
  "definitions": {
    "Topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "topicName": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "topicId",
          "topicName"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
