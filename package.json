{
  "name": "recs-replay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/build.ts dev",
    "lint": "eslint .",
    "format": "prettier --write site scripts tests *.json *.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "test": "tsx scripts/check.ts unit python",
    "test:unit": "vitest run",
    "test:python": "python3 -B -m unittest discover -s tests -p 'test_*.py'",
    "test:watch": "vitest",
    "test:model": "vitest run --config vitest.model.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:built": "PUBLIC_REPOSITORY_URL=https://github.com/example/archive-corrections vitest run --config vitest.built.config.ts",
    "check": "tsx scripts/check.ts",
    "test:archive": "pnpm validate:archive && pnpm validate:outlines && pnpm index:verify && pnpm verify:tracked && pnpm verify:preserved",
    "build:test": "SITE_BASE_PATH=/replay-check/ pnpm build && SITE_BASE_PATH=/replay-check/ PUBLIC_REPOSITORY_URL=https://github.com/example/archive-corrections pnpm build:preview",
    "test:browser": "pnpm build:test && pnpm test:built && SITE_BASE_PATH=/replay-check/ pnpm verify:pages && pnpm test:e2e && pnpm evaluate:core -- --exact-only",
    "validate:archive": "tsx scripts/archive.ts validate",
    "validate:outlines": "tsx scripts/validate-outlines.ts",
    "test:search": "vitest run tests/search.test.ts tests/search-contract.test.ts tests/search-presentation.test.ts tests/scripture-reference.test.ts tests/prepared-search.test.ts",
    "evaluate:core": "tsx scripts/evaluate-core.ts",
    "backfill": "tsx scripts/backfill.ts",
    "validate:manifest": "tsx scripts/backfill.ts validate",
    "report:archive": "tsx scripts/backfill.ts report",
    "index:verify": "tsx scripts/chapter-vectors.ts verify --all",
    "chapters:vectors": "tsx scripts/chapter-vectors.ts",
    "discover": "python3 scripts/discover.py",
    "captions:source": "python3 scripts/captions.py",
    "verify:pages": "tsx scripts/pages.ts verify",
    "verify:tracked": "tsx scripts/verify-tracked.ts",
    "verify:preserved": "tsx scripts/verify-preserved.ts",
    "benchmark:search": "tsx scripts/benchmark-search.ts",
    "benchmark:adaptive": "tsx scripts/benchmark-adaptive.ts",
    "test:e2e": "playwright test",
    "test:e2e:model": "RECS_E2E_NO_MODEL=0 playwright test --project=model",
    "build": "tsx scripts/build.ts production",
    "build:preview": "tsx scripts/build.ts preview",
    "preview": "astro preview --outDir dist/preview --host 127.0.0.1",
    "editorial:approve": "tsx scripts/editorial.ts approve",
    "editorial:guard": "tsx scripts/editorial.ts guard",
    "media:preflight": "python3 scripts/media.py preflight",
    "media:acquire": "python3 scripts/media.py acquire",
    "media:sample": "python3 scripts/media.py sample",
    "media:transcribe": "python3 scripts/media.py transcribe",
    "media:cleanup": "python3 scripts/media.py cleanup",
    "media:model": "python3 scripts/media.py model",
    "model:prepare": "tsx scripts/embeddings.ts prepare",
    "bible:verify": "tsx scripts/bible.ts verify",
    "bible:download": "tsx scripts/bible.ts download",
    "bible:generate": "tsx scripts/bible.ts generate",
    "transcripts:verify": "python3 scripts/import_transcript.py verify-bundle",
    "transcripts:import": "python3 scripts/import_transcript.py import",
    "transcripts:cleanup-audio": "python3 scripts/import_transcript.py cleanup-audio"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.2.5",
    "@fontsource-variable/domine": "^5.2.6",
    "@huggingface/transformers": "3.8.1",
    "astro": "^7.3.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.1.11"
  }
}
