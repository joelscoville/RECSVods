{
  "name": "recs-replay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/build.ts dev",
    "lint": "eslint .",
    "format": "prettier --write site scripts tests *.json *.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run && python3 -m unittest discover -s tests -p 'test_*.py'",
    "validate:archive": "tsx scripts/archive.ts validate",
    "validate:outlines": "tsx scripts/validate-outlines.ts",
    "test:search": "vitest run tests/search.test.ts tests/scripture.test.ts",
    "evaluate:core": "tsx scripts/evaluate-core.ts",
    "backfill": "tsx scripts/backfill.ts",
    "validate:manifest": "tsx scripts/backfill.ts validate",
    "report:archive": "tsx scripts/backfill.ts report",
    "index:verify": "tsx scripts/chapter-vectors.ts verify --all",
    "chapters:vectors": "tsx scripts/chapter-vectors.ts",
    "discover": "python3 scripts/discover.py",
    "captions:source": "python3 scripts/captions.py",
    "verify:pages": "tsx scripts/pages.ts verify",
    "verify:tracked": "tsx scripts/verify-tracked.ts",
    "benchmark:search": "tsx scripts/benchmark-search.ts",
    "test:e2e": "playwright test",
    "build": "tsx scripts/build.ts production",
    "build:preview": "tsx scripts/build.ts preview",
    "preview": "astro preview --outDir dist/preview --host 127.0.0.1",
    "editorial:approve": "tsx scripts/editorial.ts approve",
    "editorial:guard": "tsx scripts/editorial.ts guard",
    "media:preflight": "python3 scripts/media.py preflight",
    "media:acquire": "python3 scripts/media.py acquire",
    "media:sample": "python3 scripts/media.py sample",
    "media:transcribe": "python3 scripts/media.py transcribe",
    "media:cleanup": "python3 scripts/media.py cleanup",
    "media:model": "python3 scripts/media.py model",
    "model:prepare": "tsx scripts/embeddings.ts prepare",
    "bible:verify": "tsx scripts/bible.ts verify",
    "bible:download": "tsx scripts/bible.ts download",
    "bible:generate": "tsx scripts/bible.ts generate",
    "transcripts:verify": "python3 scripts/import_transcript.py verify-bundle",
    "transcripts:import": "python3 scripts/import_transcript.py import",
    "transcripts:cleanup-audio": "python3 scripts/import_transcript.py cleanup-audio"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.2.5",
    "@fontsource-variable/domine": "^5.2.6",
    "@huggingface/transformers": "^3.7.2",
    "astro": "^5.13.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
