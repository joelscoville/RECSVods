---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import DevWatch from '../../../components/DevWatch';
// Unlisted and never indexed; the recordings load from GitHub in the browser, never from the build.
---
<SiteLayout title="Unapproved recording" route="watch-route" noindex>
  <DevWatch base={import.meta.env.BASE_URL} client:only="react" />
  <noscript><p class="page-width">This view needs JavaScript.</p></noscript>
</SiteLayout>
