---
import SiteLayout from '../../layouts/SiteLayout.astro';
import DevTools from '../../components/DevTools';
import '../../styles/dev.css';
// Unlisted and never indexed. It holds no archive data: unapproved recordings load from GitHub in the browser.
---
<SiteLayout title="Developer tools" route="dev-route" noindex>
  <main id="main" class="page-width" tabindex="-1">
    <DevTools base={import.meta.env.BASE_URL} mode={import.meta.env.ARCHIVE_MODE} dev={import.meta.env.DEV} client:only="react" />
    <noscript><p>These tools need JavaScript.</p></noscript>
  </main>
</SiteLayout>
