---
import SiteLayout from '../layouts/SiteLayout.astro';
import Home from '../components/Home';
import { loadPublicArchive } from '../lib/public-archive';
import { homeItems } from '../components/archive-display';
const mode = import.meta.env.ARCHIVE_MODE;
const { services } = loadPublicArchive(mode);
const items = homeItems(services, import.meta.env.BASE_URL);
---
<SiteLayout title="Home" route="home-route">
  <Home items={items} base={import.meta.env.BASE_URL} client:load />
</SiteLayout>
