---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Watch from '../../components/Watch';
import { loadPublicArchive } from '../../lib/public-archive';
const mode = import.meta.env.ARCHIVE_MODE;
const { recordings } = loadPublicArchive(mode);
---
<SiteLayout title="Watch" route="watch-route" noindex>
  <Watch recordings={recordings} base={import.meta.env.BASE_URL} client:load />
</SiteLayout>
