---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ChapterEditorPage from '../../components/ChapterEditorPage';
import { editorRecordings } from '../../lib/editor-data';
import type { EditorRecording } from '../../lib/recording-editor';
import '../../styles/editor.css';
export function getStaticPaths() {
  return editorRecordings(import.meta.env.ARCHIVE_MODE).map((recording) => ({ params: { id: recording.id }, props: { recording } }));
}
interface Props { recording: EditorRecording }
const { recording } = Astro.props;
---
<SiteLayout title={`Suggest changes: ${recording.recording.recordingTitle}`} route="editor-route" header={false} noindex>
  <main id="main" tabindex="-1">
    <ChapterEditorPage recording={recording} base={import.meta.env.BASE_URL} client:only="react" />
    <noscript><p class="page-width">The chapter editor needs JavaScript.</p></noscript>
  </main>
</SiteLayout>
