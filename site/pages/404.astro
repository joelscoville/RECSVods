---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteUrl } from '../lib/urls';
---
<SiteLayout title="Page not found" noindex>
  <main id="main" class="page-width empty-archive" tabindex="-1"><h1>Page not found</h1><p>This address does not point to a page in the archive.</p><div class="action-row"><a class="button" href={siteUrl(import.meta.env.BASE_URL)}>Go to home</a><a class="text-link" href={siteUrl(import.meta.env.BASE_URL, 'search/')}>Search the archive</a></div></main>
</SiteLayout>
