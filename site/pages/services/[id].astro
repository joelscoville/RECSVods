---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadArchive, publishedServices, flattenArchive } from '../../lib/archive';
import { displayServices, type DisplayService } from '../../components/archive-display';
import { displayType, formatDate, formatTime, siteUrl, serviceUrl, watchUrl, youtubeUrl } from '../../lib/urls';
import PassageResult from '../../components/PassageResult';
import CopyLink from '../../components/CopyLink';
export function getStaticPaths() {
  const mode = import.meta.env.ARCHIVE_MODE;
  const eligible = publishedServices(loadArchive(), mode);
  return displayServices(eligible, flattenArchive(eligible, mode)).map((service) => ({ params: { id: service.id }, props: { service } }));
}
interface Props { service: DisplayService }
const { service } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<SiteLayout title={service.title} route="service-route">
  <main id="main" class="service-main page-width" tabindex="-1">
    <a class="text-link" href={siteUrl(base)}>Back to archive</a>
    <header class="service-heading">
      <h1>{service.title}</h1>
      <p class="metadata"><time datetime={service.date}>{formatDate(service.date)}</time> · {displayType(service.type)}</p>
      {service.preview && <p class="preview-label">Unreviewed preview</p>}
      <CopyLink href={serviceUrl(base, service.id)} client:load />
    </header>
    <section aria-labelledby="recordings-heading"><h2 id="recordings-heading">{service.videos.length > 1 ? 'Recordings' : 'Full recording'}</h2>
      <ul class="service-recordings">{service.videos.map((video) => <li>
        <h3>{service.videos.length > 1 ? `Video ${video.sequence}` : service.title}</h3><p>{formatTime(video.duration)}</p>
        <div class="action-row"><a class="button" href={watchUrl(base, { service: service.id, video: video.id })}>Play full recording</a><a class="text-link" href={youtubeUrl(video.id)}>Watch on YouTube</a></div>
      </li>)}</ul>
    </section>
    {service.sections.length > 0 && <section class="service-chapters" aria-labelledby="service-chapters-heading"><h2 id="service-chapters-heading">Chapters</h2><ol>{service.sections.map((section) => <li><a class="chapter-row" href={watchUrl(base, { service: service.id, video: section.videoId, start: section.start })}><span class="timestamp">{formatTime(section.start)}</span><span class="chapter-copy"><strong>{section.title}</strong><span>{displayType(section.type)} · {formatTime(section.end - section.start)}{section.speaker && ` · ${section.speaker}`}</span></span></a></li>)}</ol></section>}
    <section class="service-passages" aria-labelledby="service-passages-heading"><h2 id="service-passages-heading">Passages</h2><p>Shorter sections of the recording, each with its own summary and playback link.</p>
      {service.passages.length > 0 ? <ol class="result-list">{service.passages.map((passage) => <li><PassageResult passage={passage} base={base} /></li>)}</ol> : <p>No passages have been published for this service.</p>}
    </section>
  </main>
</SiteLayout>
