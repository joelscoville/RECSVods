---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadArchive, publishedServices, flattenChapters } from '../../lib/archive';
import { displayServices, type DisplayService } from '../../components/archive-display';
import { displayType, formatDate, formatTime, siteUrl, serviceUrl, watchUrl, youtubeUrl } from '../../lib/urls';
import CopyLink from '../../components/CopyLink';
import CorrectionLinks from '../../components/CorrectionLinks';
import { browseUrl } from '../../lib/browse';
import OutlineRows from '../../components/OutlineRows';
export function getStaticPaths() {
  const mode = import.meta.env.ARCHIVE_MODE;
  const eligible = publishedServices(loadArchive(), mode);
  return displayServices(eligible, flattenChapters(eligible, mode)).map((service) => ({ params: { id: service.id }, props: { service } }));
}
interface Props { service: DisplayService }
const { service } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<SiteLayout title={service.title} route="service-route">
  <main id="main" class="service-main page-width" tabindex="-1">
    <a class="text-link" href={siteUrl(base)}>Back to archive</a>
    <header class="service-heading">
      <h1>{service.title}</h1>
      {service.sermonDescription && <p class="sermon-description">{service.sermonDescription}</p>}
      <p class="metadata"><time datetime={service.date}>{formatDate(service.date)}</time> · {displayType(service.type)}</p>
      {service.series && <a class="text-link" href={browseUrl(base, `series/${service.series.id}`)}>Series: {service.series.name}</a>}
      {service.preview && <p class="preview-label">Unreviewed preview</p>}
      <div class="action-row"><CopyLink href={serviceUrl(base, service.id)} client:load /><CorrectionLinks target={{ serviceId: service.id }} base={base} /></div>
    </header>
    <section aria-labelledby="recordings-heading"><h2 id="recordings-heading">{service.videos.length > 1 ? 'Recordings' : 'Full recording'}</h2>
      <ul class="service-recordings">{service.videos.map((video) => <li>
        <h3>{service.videos.length > 1 ? `Video ${video.sequence}` : service.title}</h3><p>{formatTime(video.duration)}</p>
        <div class="action-row"><a class="button" href={watchUrl(base, { service: service.id, video: video.id })}>Play full recording</a><a class="text-link" href={youtubeUrl(video.id)}>Watch on YouTube</a></div>
      </li>)}</ul>
    </section>
    <section class="service-chapters" aria-labelledby="service-chapters-heading"><h2 id="service-chapters-heading">Chapters</h2>
      {service.chapters.length > 0 ? <OutlineRows service={service} base={base} client:load /> : <p>No chapters have been published for this service.</p>}
    </section>
  </main>
</SiteLayout>
