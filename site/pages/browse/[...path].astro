---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BrowsePage from '../../components/BrowsePage';
import { browseItems, type HomeItem } from '../../components/archive-display';
import { loadPublicArchive } from '../../lib/public-archive';
import { buildBrowsePages, type BrowsePage as BrowsePageData } from '../../lib/browse';
export function getStaticPaths() {
  const mode = import.meta.env.ARCHIVE_MODE;
  const { recordings } = loadPublicArchive(mode);
  const base = import.meta.env.BASE_URL;
  return buildBrowsePages(recordings).map((page) => ({ params: { path: page.path }, props: { page, items: browseItems(page, recordings, base) } }));
}
interface Props { page: BrowsePageData; items: HomeItem[] }
const { page, items } = Astro.props;
---
<SiteLayout title={page.title} route="browse-route">
  <BrowsePage page={page} items={items} base={import.meta.env.BASE_URL} client:load />
</SiteLayout>
