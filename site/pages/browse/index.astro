---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BrowseNavigation from '../../components/BrowseNavigation';
import { displayServices } from '../../components/archive-display';
import { loadArchive, publishedServices, flattenChapters } from '../../lib/archive';
import { buildBrowsePages } from '../../lib/browse';
import { siteUrl } from '../../lib/urls';
const mode = import.meta.env.ARCHIVE_MODE;
const eligible = publishedServices(loadArchive(), mode);
const categories = buildBrowsePages(displayServices(eligible, flattenChapters(eligible, mode))).filter((page) => !page.parent);
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Browse the archive" route="browse-route">
  <main id="main" class="browse-main service-main page-width" tabindex="-1">
    <a class="text-link" href={siteUrl(base)}>Back to home</a>
    <header class="service-heading"><h1>Browse the archive</h1></header>
    {categories.length ? <BrowseNavigation base={base} categories={categories} /> : <p>No published recordings yet. Browse categories will appear when recordings are ready.</p>}
  </main>
</SiteLayout>
