---
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/domine';
import '../styles/global.css';
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
import { headerSearchData } from '../lib/header-data';
interface Props { title: string; description?: string; route?: string; header?: boolean; noindex?: boolean }
const { title, description = 'Find and replay chapters from the RECS service archive.', route = '', header = true, noindex = false } = Astro.props;
const preview = import.meta.env.ARCHIVE_MODE === 'preview';
const search = headerSearchData(preview ? 'preview' : 'production');
const hasSearchContent = search.hasSearchContent;
---
<!doctype html>
<html lang="en" data-data-mode="unknown" data-compute-mode="unknown" data-base={import.meta.env.BASE_URL} data-search-content={String(hasSearchContent)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Restores this session's device check and honours Data Saver/2G/3G before any search-model work starts.
      try {
        const mode = JSON.parse(sessionStorage.getItem('recs-performance:v1') || 'null');
        if (mode && ['normal', 'save-data', 'unknown'].includes(mode.data) && ['normal', 'low-compute', 'unknown'].includes(mode.compute)) {
          document.documentElement.dataset.dataMode = mode.data;
          document.documentElement.dataset.computeMode = mode.compute;
        }
      } catch { /* Storage is optional. */ }
      const constrained = navigator.connection?.saveData || ['slow-2g', '2g', '3g'].includes(navigator.connection?.effectiveType);
      if (constrained) document.documentElement.dataset.dataMode = 'save-data';
      // Modes forced on the hidden /dev page win, and a badge says so.
      try {
        const forced = JSON.parse(localStorage.getItem('recs-dev:performance') || 'null');
        if (forced && (forced.data === 'normal' || forced.data === 'save-data')) document.documentElement.dataset.dataMode = forced.data;
        if (forced && (forced.compute === 'normal' || forced.compute === 'low-compute')) document.documentElement.dataset.computeMode = forced.compute;
        if ((forced && (forced.data || forced.compute)) || localStorage.getItem('recs-dev:unapproved') === '1') document.documentElement.dataset.devOverride = 'true';
      } catch { /* Storage is optional. */ }
    </script>
    <script>
      import { startAdaptiveLoading } from '../lib/adaptive-loading';
      startAdaptiveLoading(document.documentElement.dataset.base!, document.documentElement.dataset.searchContent === 'true', { measureCompute: !import.meta.env.DEV });
    </script>
    <meta name="description" content={description} />
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#FAFAFF" />
    <title>{title} | RECS Replay</title>
  </head>
  <body class={route}>
    <a class="skip-link" href="#main">Skip to content</a>
    {header && <Header base={import.meta.env.BASE_URL} categories={search?.categories} topics={search?.topics} client:load />}
    <slot />
    <Footer />
  </body>
</html>
